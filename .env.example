# Copy to .env and adjust. Docker Compose reads .env automatically.
# These settings are for using the app from other devices; without .env, Compose uses development defaults.

# The address the app is opened with — from this computer and from other devices alike.
# Use this computer's network address so phones can log in and open scanned labels, e.g.
# FREEZER_URL=https://192.168.1.20:8443
FREEZER_URL=https://localhost:8443

# The realm Keycloak starts with: without the demo users (alice, bob and carol, whose passwords are their names) and
# without the freezer-dev-cli client for password logins with curl. Development uses ./infra/keycloak/dev.
# Keycloak imports it only into an empty data volume: if Keycloak ran with the demo users before, remove its data
# first (docker compose down, then docker volume rm freezer_keycloak-data). That deletes all of its accounts.
KEYCLOAK_REALM_DIR=./infra/keycloak/lan

# Passwords of the database (user freezer) and of Keycloak's admin console (user admin, http://localhost:8081).
# Neither service is reachable from other devices, but choose your own. Left empty, Compose uses the development
# defaults freezer and admin. Both apply when the data is first created; to change them later, change them in the
# service (or remove its volume, losing its data). A backend run on the host (./mvnw spring-boot:run) then needs
# SPRING_DATASOURCE_PASSWORD as well.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
