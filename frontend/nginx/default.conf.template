# Serves the app, the API and Keycloak under one HTTPS address: ${FREEZER_URL}
# (nginx's image fills in ${FREEZER_URL} at start; nginx variables like $host stay as they are).

server {
    listen 80;
    server_name _;
    return 301 ${FREEZER_URL}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    root /usr/share/nginx/html;

    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;

    # Photos are uploaded through /api; the backend accepts requests up to 9 MB.
    client_max_body_size 10m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Keycloak: the app's realm (login pages, tokens) and its static files. Tokens name this address as issuer.
    # Neither the admin console nor other realms are reachable from here; Keycloak's own port is bound to localhost.
    location ~ ^/(realms/freezer|resources|js)/ {
        proxy_pass http://keycloak:8080;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }

    # File names with a content hash (main-ABCD1234.js, media/inter-...-ABCD1234.woff2) never change: cache them.
    location ~* "-[A-Z0-9]{8}\.(js|css|woff2)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Translations keep their names; check for new versions.
    location /i18n/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Client-side routes (/households/..., /s/<label code>) all load the app.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
